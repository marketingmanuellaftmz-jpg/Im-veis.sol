      const imported = JSON.parse(reader.result);
      state = imported;
      saveState(state);
      render();
      alert('Backup importado com sucesso.');
    }catch(err){
      alert('Não foi possível ler esse arquivo. Verifique se é um backup exportado por este site.');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
});

