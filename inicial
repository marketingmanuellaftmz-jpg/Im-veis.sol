function slug(s){
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-');
}

function tipoClass(tipo){
  if(tipo==="Venda") return "tipo-venda";
  if(tipo==="Locação") return "tipo-locacao";
  return "tipo-ambos";
}
function statusClass(status){
  return "status-"+status;
}
function statusLabel(status){
  return {disponivel:"Disponível", negociando:"Negociando", vendido:"Vendido/Alugado"}[status] || status;
}

function fileToBase64(file){
  return new Promise((resolve,reject)=>{
    const r = new FileReader();
    r.onload = ()=>resolve(r.result);
    r.onerror = reject;
    r.readAsDataURL(file);
  });
}

function renderCard(item){
  const entry = getEntry(item.key);
  const card = document.createElement('div');
  card.className = 'card';
  card.dataset.key = item.key;

  const idLine = item.custom
    ? `<div class="card-id">${item.cod ? item.cod+' · ' : ''}<span class="custom-tag">adicionado por você</span></div>`
    : `<div class="card-id">Nº <b>${item.n}</b> · ${item.cod}</div>`;

  card.innerHTML = `
    <div class="card-top">
      ${idLine}
      <span class="tipo-tag ${tipoClass(item.tipo)}">${item.tipo}</span>
    </div>
    <p class="endereco">${item.end}</p>
    ${item.custom ? '<button class="remove-btn" data-role="remove">Remover este imóvel</button>' : ''}
    <div class="status-row">
      <select class="status-select ${statusClass(entry.status)}">
        <option value="disponivel" ${entry.status==='disponivel'?'selected':''}>Disponível</option>
        <option value="negociando" ${entry.status==='negociando'?'selected':''}>Negociando</option>
        <option value="vendido" ${entry.status==='vendido'?'selected':''}>Vendido/Alugado</option>
      </select>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Nome do proprietário</label>
        <input type="text" class="nome-input" placeholder="Nome" value="${escapeHtml(entry.nome)}">
      </div>
      <div class="field">
        <label>Telefone</label>
        <input type="text" class="telefone-input" placeholder="(11) 90000-0000" value="${escapeHtml(entry.telefone)}">
      </div>
    </div>
    <div class="field">
      <label>Data da visita</label>
      <input type="date" class="visita-input" value="${escapeHtml(entry.dataVisita)}">
    </div>
    <div class="field">
      <label>Observações</label>
      <textarea class="obs-input" placeholder="Anotações sobre o imóvel, negociação, chaves...">${escapeHtml(entry.obs)}</textarea>
    </div>
    <div class="field">
      <label>Fotos</label>
      <div class="fotos-row" data-role="fotos-row"></div>
    </div>
  `;

  // status
  const statusSel = card.querySelector('.status-select');
  statusSel.addEventListener('change', ()=>{
    entry.status = statusSel.value;
    statusSel.className = 'status-select ' + statusClass(entry.status);
    saveState(state);
    updateStatLine();
  });

  // nome do proprietário
  const nomeInput = card.querySelector('.nome-input');
  nomeInput.addEventListener('input', ()=>{
    entry.nome = nomeInput.value;
    saveState(state);
  });

  // telefone
  const telefoneInput = card.querySelector('.telefone-input');
  telefoneInput.addEventListener('input', ()=>{
    entry.telefone = telefoneInput.value;
    saveState(state);
  });

  // data da visita
  const visitaInput = card.querySelector('.visita-input');
  visitaInput.addEventListener('input', ()=>{
    entry.dataVisita = visitaInput.value;
    saveState(state);
  });

  // obs
  const obsInput = card.querySelector('.obs-input');
  obsInput.addEventListener('input', ()=>{
    entry.obs = obsInput.value;
    saveState(state);
  });

  // fotos
  const fotosRow = card.querySelector('[data-role="fotos-row"]');
  function renderFotos(){
    fotosRow.innerHTML = '';
    entry.fotos.forEach((src, idx)=>{
      const thumb = document.createElement('div');
      thumb.className = 'foto-thumb';
      thumb.innerHTML = `<img src="${src}" alt="Foto do imóvel ${item.cod}"><button title="Remover">×</button>`;
      thumb.querySelector('button').addEventListener('click', ()=>{
        entry.fotos.splice(idx,1);
        saveState(state);
        renderFotos();
      });
      fotosRow.appendChild(thumb);
    });
    const addBtn = document.createElement('label');
    addBtn.className = 'foto-add';
    addBtn.title = 'Adicionar foto';
    addBtn.innerHTML = `+<input type="file" accept="image/*" multiple>`;
    addBtn.querySelector('input').addEventListener('change', async (e)=>{
      const files = Array.from(e.target.files);
      for(const f of files){
        try{
          const b64 = await fileToBase64(f);
          entry.fotos.push(b64);
        }catch(err){}
      }
      saveState(state);
      renderFotos();
    });
    fotosRow.appendChild(addBtn);
  }
  renderFotos();

  // remover (apenas itens adicionados manualmente)
  const removeBtn = card.querySelector('[data-role="remove"]');
  if(removeBtn){
    removeBtn.addEventListener('click', ()=>{
      if(!confirm('Remover este imóvel da carteira?')) return;
      customItems = customItems.filter(i=>i.key !== item.key);
      delete state[item.key];
      saveCustom();
      saveState(state);
      rebuildBairroUI();
      render();
    });
  }

  return card;
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str || '';
  return d.innerHTML;
}

const resultsEl = document.getElementById('results');

function currentFilters(){
  return {
    q: document.getElementById('searchInput').value.trim().toLowerCase(),
    bairro: document.getElementById('filterBairro').value,
    tipo: document.getElementById('filterTipo').value,
    status: document.getElementById('filterStatus').value,
  };
}

function matches(item, f){
  const entry = getEntry(item.key);
  if(f.bairro && item.bairro !== f.bairro) return false;
  if(f.tipo && item.tipo !== f.tipo) return false;
  if(f.status && entry.status !== f.status) return false;
  if(f.q){
    const hay = `${item.end} ${item.cod||''} ${item.bairro} ${entry.nome} ${entry.telefone} ${entry.obs} ${item.n||''}`.toLowerCase();
    if(!hay.includes(f.q)) return false;
  }
  return true;
}

function render(){
  const f = currentFilters();
  resultsEl.innerHTML = '';
  let shown = 0;
  const items = allItems();

  getBairros().forEach(bairro=>{
    const bairroItems = items.filter(i=>i.bairro===bairro && matches(i,f));
    if(bairroItems.length === 0) return;
    shown += bairroItems.length;

    const section = document.createElement('section');
    section.className = 'bairro-section';
    section.id = 'sec-' + slug(bairro);

    const head = document.createElement('div');
    head.className = 'bairro-head';
    head.innerHTML = `<h2>${bairro}</h2><span class="bairro-count">${bairroItems.length} ${bairroItems.length===1?'imóvel':'imóveis'}</span>`;
    section.appendChild(head);

    const grid = document.createElement('div');
    grid.className = 'grid';
    bairroItems.sort((a,b)=>(a.n||9999)-(b.n||9999)).forEach(item=> grid.appendChild(renderCard(item)));
    section.appendChild(grid);

    resultsEl.appendChild(section);
  });

  if(shown === 0){
    resultsEl.innerHTML = '<div class="empty">Nenhum imóvel encontrado com esses filtros.</div>';
  }
  document.getElementById('totalCount').textContent = items.length;
  updateStatLine(shown);
}

function updateStatLine(shownCount){
  const items = allItems();
  const total = items.length;
  const disp = items.filter(i=>getEntry(i.key).status==='disponivel').length;
  const neg = items.filter(i=>getEntry(i.key).status==='negociando').length;
  const vend = items.filter(i=>getEntry(i.key).status==='vendido').length;
  const shown = shownCount !== undefined ? shownCount : items.filter(i=>matches(i,currentFilters())).length;
  document.getElementById('statLine').textContent =
    `Mostrando ${shown} de ${total} · Disponíveis: ${disp} · Negociando: ${neg} · Vendidos/Alugados: ${vend}`;
}

['searchInput'].forEach(id=>{
  document.getElementById(id).addEventListener('input', render);
});
['filterBairro','filterTipo','filterStatus'].forEach(id=>{
  document.getElementById(id).addEventListener('change', render);
});

