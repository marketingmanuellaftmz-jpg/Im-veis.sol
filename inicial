const noteStatus = document.getElementById('noteStatus');

function renderNotesList(){
  notesListItems.innerHTML = '';
  if(notes.length === 0){
    notesListItems.innerHTML = '<div class="notes-empty">Nenhuma nota salva ainda.</div>';
    return;
  }
  [...notes].sort((a,b)=> new Date(b.updatedAt) - new Date(a.updatedAt)).forEach(note=>{
    const el = document.createElement('div');
    el.className = 'note-item' + (note.id === currentNoteId ? ' active' : '');
    el.innerHTML = `<div class="n-title">${escapeHtml(noteTitle(note))}</div><div class="n-date">${formatDate(note.updatedAt)}</div>`;
    el.addEventListener('click', ()=> openNote(note.id));
    notesListItems.appendChild(el);
  });
}

function openNote(id){
  const note = notes.find(n=>n.id===id);
  if(!note) return;
  currentNoteId = id;
  noteContent.value = note.content;
  noteStatus.textContent = 'Editando: ' + noteTitle(note);
  renderNotesList();
}

function newNoteDraft(){
  currentNoteId = null;
  noteContent.value = '';
  noteStatus.textContent = 'Nova nota (ainda não salva)';
  renderNotesList();
  noteContent.focus();
}

document.getElementById('newNoteBtn').addEventListener('click', newNoteDraft);

document.getElementById('saveNoteBtn').addEventListener('click', ()=>{
  const content = noteContent.value;
  if(!content.trim()){ noteStatus.textContent = 'Escreva algo antes de salvar.'; return; }
  const note = {
    id: 'note-' + Date.now() + '-' + Math.random().toString(36).slice(2,7),
    content: content,
    updatedAt: new Date().toISOString()
  };
  notes.push(note);
  saveNotes();
  currentNoteId = note.id;
  noteStatus.textContent = 'Salvo como novo arquivo: ' + noteTitle(note);
  renderNotesList();
});

document.getElementById('updateNoteBtn').addEventListener('click', ()=>{
  if(!currentNoteId){ noteStatus.textContent = 'Nenhuma nota aberta para atualizar — use "Salvar como novo arquivo".'; return; }
  const note = notes.find(n=>n.id===currentNoteId);
  if(!note) return;
  note.content = noteContent.value;
  note.updatedAt = new Date().toISOString();
  saveNotes();
  noteStatus.textContent = 'Alterações salvas: ' + noteTitle(note);
  renderNotesList();
});

document.getElementById('deleteNoteBtn').addEventListener('click', ()=>{
  if(!currentNoteId){ noteStatus.textContent = 'Nenhuma nota aberta para excluir.'; return; }
  if(!confirm('Excluir esta nota?')) return;
  notes = notes.filter(n=>n.id!==currentNoteId);
  saveNotes();
  newNoteDraft();
});

document.getElementById('downloadNoteBtn').addEventListener('click', ()=>{
  const content = noteContent.value;
  if(!content.trim()){ noteStatus.textContent = 'Escreva algo antes de baixar.'; return; }
  const title = currentNoteId
    ? noteTitle(notes.find(n=>n.id===currentNoteId) || {content})
    : noteTitle({content});
  const safeTitle = title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').slice(0,40);
  const blob = new Blob([content], {type:'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `nota-${safeTitle || 'sem-titulo'}-${new Date().toISOString().slice(0,10)}.txt`;
  a.click();
  URL.revokeObjectURL(url);
});

renderNotesList();

/* ---------- Inicialização ---------- */
rebuildBairroUI();
render();
</script>
</body>
</html>
