addForm.addEventListener('submit', (e)=>{
  e.preventDefault();
  const bairro = document.getElementById('newBairro').value.trim();
  const end = document.getElementById('newEndereco').value.trim();
  const cod = document.getElementById('newCodigo').value.trim();
  const tipo = document.getElementById('newTipo').value;
  const nome = document.getElementById('newNome').value.trim();
