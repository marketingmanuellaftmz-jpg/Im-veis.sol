/* ---------- Estado editável (persistido no localStorage) ---------- */
const STORAGE_KEY = "carteira_imoveis_v1";
const CUSTOM_KEY = "carteira_imoveis_custom_v1";

let storageAvisoMostrado = false;
function safeStorageSet(key, value){
  try{
    localStorage.setItem(key, value);
    return true;
  }catch(e){
    if(!storageAvisoMostrado){
      storageAvisoMostrado = true;
      alert('Este navegador está bloqueando o salvamento automático (comum em navegadores dentro de apps como Instagram/WhatsApp, ou no modo anônimo). O que você adicionar vai continuar funcionando nesta visita, mas não vai ficar salvo ao fechar a página. Abra o arquivo direto no Chrome ou Safari para salvar normalmente.');
    }
    return false;
  }
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : {};
  }catch(e){ return {}; }
}
function saveState(state){
  safeStorageSet(STORAGE_KEY, JSON.stringify(state));
}
let state = loadState();

function loadCustom(){
  try{
    const raw = localStorage.getItem(CUSTOM_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed : [];
  }catch(e){ return []; }
}
function saveCustom(){
  safeStorageSet(CUSTOM_KEY, JSON.stringify(customItems));
}
let customItems = loadCustom();

function allItems(){
  return IMOVEIS.concat(customItems);
}

function getEntry(key){
  if(!state[key]){
    state[key] = {status:"disponivel", nome:"", telefone:"", dataVisita:"", obs:"", fotos:[]};
  }
  // migração: versões antigas usavam um único campo "contato"
  if(state[key].contato !== undefined && !state[key].nome && !state[key].telefone){
    state[key].nome = state[key].contato;
    state[key].telefone = "";
  }
  if(state[key].nome === undefined) state[key].nome = "";
  if(state[key].telefone === undefined) state[key].telefone = "";
  if(state[key].dataVisita === undefined) state[key].dataVisita = "";
  return state[key];
}

